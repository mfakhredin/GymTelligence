@page "/reset-password"
@attribute [AllowAnonymous]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Set new password — GymTelligence</PageTitle>
<section class="auth-page">
    <div class="auth-art">
        <div class="auth-grid"></div><span class="vertical-word">SECURE / ROTATE / RESUME</span>
        <div class="auth-art-copy"><span>04</span><h1>Re-enter<br>stronger.</h1><p>Your new credential is hashed server-side and the recovery link can only be used once.</p></div>
        <div class="auth-orbit"><i></i><b>✦</b></div>
    </div>
    <div class="auth-form-wrap">
        <div class="auth-heading"><p class="eyebrow"><i></i> Choose a new password</p><h2>Secure your account.</h2><p>Use at least eight characters, including a letter and a number.</p></div>
        <AlertMessage Message="@error" />
        <EditForm Model="form" OnValidSubmit="Submit" class="form-stack">
            <DataAnnotationsValidator />
            <label>New password<InputText @bind-Value="form.NewPassword" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => form.NewPassword)" /></label>
            <label>Confirm password<InputText @bind-Value="form.ConfirmPassword" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => form.ConfirmPassword)" /></label>
            <button class="button primary xl full" disabled="@(busy || !hasToken)"><AppIcon Name="shield" /> @(busy ? "Saving password…" : "SET NEW PASSWORD")</button>
        </EditForm>
        @if (!hasToken) { <p class="auth-switch">This link is incomplete. <a href="/forgot-password">Request a new one</a>.</p> }
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public string? Selector { get; set; }
    [SupplyParameterFromQuery] public string? Validator { get; set; }
    private readonly ResetPasswordForm form = new();
    private string? error;
    private bool busy;
    private bool hasToken => !string.IsNullOrWhiteSpace(Selector) && !string.IsNullOrWhiteSpace(Validator);

    protected override void OnParametersSet()
    {
        form.Selector = Selector ?? string.Empty;
        form.Validator = Validator ?? string.Empty;
    }

    private async Task Submit()
    {
        busy = true; error = null;
        try
        {
            await Api.PostAsync("api/auth/reset-password", new { form.Selector, form.Validator, form.NewPassword });
            Navigation.NavigateTo("/login?reset=true");
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
