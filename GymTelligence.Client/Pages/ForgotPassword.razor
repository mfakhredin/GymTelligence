@page "/forgot-password"
@attribute [AllowAnonymous]
@inject ApiClient Api

<PageTitle>Recover access — GymTelligence</PageTitle>
<section class="auth-page">
    <div class="auth-art">
        <div class="auth-grid"></div><span class="vertical-word">RECOVER / VERIFY / RETURN</span>
        <div class="auth-art-copy"><span>03</span><h1>Find your<br>signal.</h1><p>Request a single-use recovery link. It expires after one hour.</p></div>
        <div class="auth-orbit"><i></i><b>↺</b></div>
    </div>
    <div class="auth-form-wrap">
        <div class="auth-heading"><p class="eyebrow"><i></i> Password recovery</p><h2>Reset your password.</h2><p>Enter the email address connected to your account.</p></div>
        <AlertMessage Message="@message" Kind="@(success ? "success" : "error")" />
        <EditForm Model="form" OnValidSubmit="Submit" class="form-stack">
            <DataAnnotationsValidator />
            <label>Email address<InputText @bind-Value="form.Email" type="email" autocomplete="email" /><ValidationMessage For="@(() => form.Email)" /></label>
            <button class="button primary xl full" disabled="@busy"><AppIcon Name="arrow" /> @(busy ? "Preparing link…" : "SEND RESET LINK")</button>
        </EditForm>
        @if (!string.IsNullOrWhiteSpace(resetUrl))
        {
            <a class="button ghost full" href="@resetUrl">Open development reset link</a>
        }
        <p class="auth-switch"><a href="/login">Return to login</a></p>
    </div>
</section>

@code {
    private readonly ForgotPasswordForm form = new();
    private string? message;
    private string? resetUrl;
    private bool success;
    private bool busy;

    private async Task Submit()
    {
        busy = true; message = null; resetUrl = null;
        try
        {
            var result = await Api.PostAsync<ForgotPasswordResponse>("api/auth/forgot-password", form);
            message = result.Message; resetUrl = result.DevelopmentResetUrl; success = true;
        }
        catch (ApiException ex) { message = ex.Message; success = false; }
        finally { busy = false; }
    }
}
